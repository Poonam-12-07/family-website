# Copy to server/.env and fill in. server/.env is git-ignored.

# From the sheet URL: docs.google.com/spreadsheets/d/<THIS PART>/edit
GOOGLE_SHEET_ID=your-spreadsheet-id

# Local: path to the service account key (relative to server/)
GOOGLE_APPLICATION_CREDENTIALS=service-account.json
# Hosted (e.g. Vercel): paste the whole key JSON on one line instead
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

PORT=3001

# People shown on the Health chart, in legend order
FAMILY_MEMBERS=Alex,Sam,Kid One,Kid Two

# Family Board cards: <value in the Notes "User" column>:<card title>
NOTE_BOARDS=alex:Her Notes,sam:Him Notes

# Weather shown in the top bar (Open-Meteo, no key needed)
WEATHER_LAT=37.7749
WEATHER_LON=-122.4194
WEATHER_LABEL=San Francisco, CA
